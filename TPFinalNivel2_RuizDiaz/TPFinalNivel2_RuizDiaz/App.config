<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
  <connectionStrings>
    <add name="CatalogoDB" connectionString="server=.\SQLEXPRESS; database=CATALOGO_DB_RECUPERADA; integrated security=true" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="images-folder" value="C:\tpapp\"/>
  </appSettings>
</configuration>
