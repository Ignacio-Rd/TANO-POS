<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Base DE PRUEBAS (no la de producción). Se crea con BaseDeDatos\CATALOGO_DB_RECUPERADA.sql cambiando el nombre.
         En GitHub Actions este valor se reemplaza para apuntar a la instancia del servidor de CI. -->
    <add name="CatalogoDB" connectionString="server=.\SQLEXPRESS; database=CATALOGO_DB_TEST; integrated security=true" providerName="System.Data.SqlClient"/>
  </connectionStrings>
</configuration>
